# .env.example — copy to .env for local development
# Local dev defaults assume services running on localhost (not Docker)

# Redis
COMPASS_REDIS_URL=redis://localhost:6379/0

# RabbitMQ
COMPASS_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Prometheus
COMPASS_PROMETHEUS_URL=http://localhost:9090
COMPASS_PROMETHEUS_TIMEOUT_SECONDS=5.0
COMPASS_PROMETHEUS_CACHE_TTL_SECONDS=300

# Loki
COMPASS_LOKI_URL=http://localhost:3100
COMPASS_LOKI_TIMEOUT_SECONDS=5.0
COMPASS_LOKI_CACHE_TTL_SECONDS=300

# Kubernetes in-process watcher
# Set to true to enable — requires list/watch pod permissions.
COMPASS_K8S_WATCH_ENABLED=false
# Comma-separated namespaces to watch (leave empty for cluster-wide).
COMPASS_K8S_NAMESPACES=[]
# Absolute path to kubeconfig. Omit to auto-detect (in-cluster token → ~/.kube/config).
# COMPASS_K8S_KUBECONFIG=/path/to/.kube/config
# Reconnect delay in seconds when the watch stream drops.
COMPASS_K8S_WATCH_RECONNECT_DELAY_SECONDS=5.0
# .env.example — copy to .env for local development
# Local dev defaults assume services running on localhost (not Docker)

# Redis
COMPASS_REDIS_URL=redis://localhost:6379/0

# RabbitMQ
COMPASS_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Prometheus
COMPASS_PROMETHEUS_URL=http://localhost:9090
COMPASS_PROMETHEUS_TIMEOUT_SECONDS=5.0
COMPASS_PROMETHEUS_CACHE_TTL_SECONDS=300

# Loki
COMPASS_LOKI_URL=http://localhost:3100
COMPASS_LOKI_TIMEOUT_SECONDS=5.0
COMPASS_LOKI_CACHE_TTL_SECONDS=300